# NIGHTSHIFT local development only. Never commit a real .env file.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/secure_api_portal

# Generate a random value with at least 32 bytes of entropy.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# First-start bootstrap only. Remove both from the host environment after the
# initial administrator is created. Never reuse a password from another service.
ADMIN_USERNAME=replace-with-your-admin-username
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters

# Configure only after the Python service has a documented, authenticated API
# endpoint intended for authorized business operations. Do NOT point this at
# the Telegram /webhook, /health, or /admin routes.
UPSTREAM_URL=https://your-authorized-service.example/api/v1/approved-operation
UPSTREAM_KEY=replace-with-a-dedicated-upstream-api-key
UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_AUTH_SCHEME=Bearer

# Match only the approved API's documented, non-sensitive parameter names.
# The current gateway accepts id,type,page; do not change these blindly.
UPSTREAM_ALLOWED_PARAMS=id,type,page

# Defaults for newly generated NIGHTSHIFT user API keys
DEFAULT_KEY_QUOTA=1000
DEFAULT_KEY_RATE_PER_MINUTE=10

# Optional: exact public origin used for same-origin admin form checks.
# Example: https://your-nightshift-service.onrender.com
# PUBLIC_ORIGIN=
