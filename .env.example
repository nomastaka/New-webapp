# Required
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/secure_api_portal
SESSION_SECRET=replace-with-at-least-32-random-bytes

# First-run admin bootstrap only. Remove both after the first successful startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Fixed upstream destination. HTTPS required outside local development.
UPSTREAM_URL=https://api.example.com/v1/query
UPSTREAM_KEY=
UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_AUTH_SCHEME=Bearer

# Comma-separated query names allowed to be forwarded. Never accept a destination URL from users.
UPSTREAM_ALLOWED_PARAMS=id,type,page

# Defaults for newly generated keys
DEFAULT_KEY_QUOTA=1000
DEFAULT_KEY_RATE_PER_MINUTE=10
